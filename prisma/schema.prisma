generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  team         String   @default("Nurses") @db.VarChar(50)
  initials     String?  @db.VarChar(5)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  bookings                Booking[]                @relation("NurseBookings")
  pushSubscriptions       PushSubscription[]
  inventoryAssignments    InventoryAssignment[]
  bulkMedicineAssignments BulkMedicineAssignment[]

  @@map("bk_users")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@map("bk_clients")
}

model Booking {
  id             Int           @id @default(autoincrement())
  taskId         String        @unique @map("task_id") @db.VarChar(20)
  jobId          String?       @map("job_id") @db.VarChar(20)
  orderId        String?       @map("order_id") @db.VarChar(50)
  clientId       Int           @map("client_id")
  nurseId        Int?          @map("nurse_id")
  status         BookingStatus @default(unassigned)
  service        String?       @db.VarChar(100)
  address        String?       @db.Text
  description    String?       @db.Text
  timeSlot       String?       @map("time_slot") @db.VarChar(50)
  bookingDate    DateTime?     @map("booking_date") @db.Date
  paymentMethod  String?       @map("payment_method") @db.VarChar(50)
  paymentHeldFor String?       @map("payment_held_for") @db.VarChar(150)
  location       String?       @db.VarChar(100)
  trackingLink   String?       @map("tracking_link") @db.VarChar(500)
  distance       Decimal?      @db.Decimal(5, 2)
  timeTaken      Decimal?      @map("time_taken") @db.Decimal(5, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  client  Client           @relation(fields: [clientId], references: [id])
  nurse   User?            @relation("NurseBookings", fields: [nurseId], references: [id])
  history BookingHistory[]
  drips   BookingDrip[]

  @@map("bk_bookings")
}

model BookingHistory {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @map("booking_id")
  action      String   @db.VarChar(255)
  performedBy String?  @map("performed_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("bk_booking_history")
}

model BookingDrip {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  kind      VialKind
  dripName  String?  @map("drip_name") @db.VarChar(100)
  nss       String?  @db.VarChar(50)
  nssQty    Int      @default(1) @map("nss_qty")
  createdAt DateTime @default(now()) @map("created_at")

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vials     BookingVial[]
  medicines BookingMedicine[]

  @@index([bookingId])
  @@map("bk_booking_drips")
}

model BookingVial {
  id     Int     @id @default(autoincrement())
  dripId Int     @map("drip_id")
  itemId Int     @map("item_id")
  qty    Decimal @db.Decimal(10, 2)

  drip BookingDrip   @relation(fields: [dripId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([dripId])
  @@index([itemId])
  @@map("bk_booking_vials")
}

model BookingMedicine {
  id         Int     @id @default(autoincrement())
  dripId     Int     @map("drip_id")
  medicineId Int     @map("medicine_id")
  qty        Decimal @db.Decimal(10, 2)

  drip     BookingDrip  @relation(fields: [dripId], references: [id], onDelete: Cascade)
  medicine BulkMedicine @relation(fields: [medicineId], references: [id])

  @@index([dripId])
  @@index([medicineId])
  @@map("bk_booking_medicines")
}

model Service {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bk_services")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bk_push_subscriptions")
}

model InventoryItem {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  serial    String    @unique @db.VarChar(50)
  qty       Decimal   @db.Decimal(10, 2)
  unit      String    @default("ml") @db.VarChar(20)
  location  String?   @db.VarChar(100)
  expiry    DateTime? @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  assignments  InventoryAssignment[]
  bookingVials BookingVial[]

  @@map("bk_inventory_items")
}

model BulkMedicine {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  qty       Decimal   @db.Decimal(10, 2)
  unit      String    @default("ml") @db.VarChar(20)
  expiry    DateTime? @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  bookingMedicines BookingMedicine[]
  locations        BulkMedicineLocation[]
  assignments      BulkMedicineAssignment[]

  @@map("bk_bulk_medicines")
}

model InventoryAssignment {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  nurseId   Int      @map("nurse_id")
  qty       Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nurse User          @relation(fields: [nurseId], references: [id])

  @@unique([itemId, nurseId])
  @@index([nurseId])
  @@map("bk_inventory_assignments")
}

model BulkMedicineLocation {
  id         Int      @id @default(autoincrement())
  medicineId Int      @map("medicine_id")
  location   String   @db.VarChar(100)
  qty        Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  medicine BulkMedicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, location])
  @@map("bk_bulk_medicine_locations")
}

model BulkMedicineAssignment {
  id         Int      @id @default(autoincrement())
  medicineId Int      @map("medicine_id")
  nurseId    Int      @map("nurse_id")
  qty        Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  medicine BulkMedicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  nurse    User         @relation(fields: [nurseId], references: [id])

  @@unique([medicineId, nurseId])
  @@index([nurseId])
  @@map("bk_bulk_medicine_assignments")
}

enum VialKind {
  cs_drip
  upsell
}

enum UserRole {
  admin
  nurse
}

enum BookingStatus {
  unassigned
  assigned
  ontheway
  progress
  completed
  cancelled
}
